 void QgsCameraPose::setDistanceFromCenterPoint( float distance )
 {
   mDistanceFromCenterPoint = std::max( distance, 10.0f );
 }
+
+void QgsCameraPose::setDistanceFromCenterPoint( float distance, float minimumDistance )
+{
+  if ( std::isfinite( distance ) && std::isfinite( minimumDistance ) )
+    mDistanceFromCenterPoint = std::max( distance, std::max( minimumDistance, 0.001f ) );
+}
