+namespace
+{
+  // Opt-in per canvas. Existing map views retain their original distance limits.
+  float minimumZoomDistance( const QgsCameraController *controller )
+  {
+    const float value = controller->property( "localMinimumZoomDistance" ).toFloat();
+    return std::isfinite( value ) && value > 0 ? std::max( value, 0.001f ) : 10.0f;
+  }
